# Copy this file to .env and adjust values. Never commit .env.
DB_PATH=data/feedback.db
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_MAX_TOKENS=512
SENTIMENT_BATCH_SIZE=8
SENTIMENT_LOW_CONFIDENCE=0.6
# Experimental, off by default (saves memory; check accuracy first):
SENTIMENT_QUANTIZE=0
# Set to 1 for a public demo: limits CSV uploads to DEMO_MAX_CSV_ROWS rows
DEMO_MODE=0
DEMO_MAX_CSV_ROWS=300
MAX_EXTRA_COLUMNS=30
MAX_EXTRA_VALUE_LENGTH=500
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
MAX_CSV_ROWS=5000
MAX_REVIEW_LENGTH=2000

# Optional AI question planner (Google Gemini free tier). Leave empty to use rules only.
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_DAILY_LIMIT=15
LLM_SESSION_LIMIT=4
LLM_MINUTE_LIMIT=10
# 1 = "summarise ..." questions send up to 12 short review excerpts to Gemini (emails/phones/links removed). 0 = never.
AI_SUMMARIES=1
PLANNER_MODE=hybrid
